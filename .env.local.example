# Supabase — Server-Side Auth (Next.js App Router) — CLAUDE.md §14
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Painel do Supabase: Project Settings > API.

# Project URL (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (começa com sb_publishable_...).
# Pode ir ao browser — substitui a antiga "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secret (começa com sb_secret_...).
# SOMENTE no servidor. NUNCA expor no client nem commitar. Substitui a antiga
# "service_role". Usada futuramente para ações admin (ex.: criar associados).
SUPABASE_SECRET_KEY=

# Google Analytics 4 — ID de métrica do fluxo de dados (formato G-XXXXXXXXXX).
# Painel do GA: Admin > Fluxos de dados > (seu site).
# Carregado só na landing /conecte-se-2026. Sem valor, o script não é injetado.
NEXT_PUBLIC_GA_ID=
